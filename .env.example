# ============================================================
# 蓝色大肥鱼 bot 配置文件
# 用法：复制本文件为 .env，然后按下面说明填写
#   Windows 命令行：copy .env.example .env
# 注意：.env 里有密钥，不要发给别人、不要传到网上
# ============================================================

# ---------- 1. 连接 NapCat（OneBot 11） ----------
# NapCat 的 WebUI → 网络配置 → WebSocket服务器 里填的那个地址和端口。
# 如果 NapCat 和 bot 在同一台电脑上，通常就是下面这样。
ONEBOT_WS_URL=ws://127.0.0.1:3001

# 与 NapCat 里 WebSocket服务器 配置的 Token 保持一致；没设 token 就留空。
# 建议设一个随机字符串，防止本机其他程序乱连你的 QQ。
ONEBOT_ACCESS_TOKEN=

# ---------- 2. 大模型（OpenAI 兼容接口） ----------
# 默认用 DeepSeek（“蓝色大肥鱼”本鱼）。
# 注册拿 Key：https://platform.deepseek.com/api_keys
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里填你的APIKey
LLM_MODEL=deepseek-chat

# 0~2，越高越“自由发挥”；群聊建议 1.0~1.3
LLM_TEMPERATURE=1.1
# 单次回复的最大 token 数，群聊短句 200~300 就够了
LLM_MAX_TOKENS=240
# 大模型接口超时时间（毫秒）
LLM_TIMEOUT_MS=60000

# ---------- 3. 机器人身份与安全 ----------
# 机器人的群昵称（人设卡片里的名字，仅用于日志和 prompt）
BOT_NICKNAME=蓝色大肥鱼
# 机器人自己的 QQ 号，一般不用填，启动后会自动读取；
# 如果 NapCat 的接口取不到，再手动填这里
BOT_QQ=
# 只允许在哪些群工作（群号，英文逗号分隔）；留空 = 所有群都接。
# 强烈建议先填上自己测试群的群号，避免在别人的群里突然说话。
# 群号在哪看：QQ 群资料页里那串数字；或者先留空启动，在测试群发条消息 @ 它，
# 日志里会打印 [群 123456789]，把那个数字填进来。
ALLOWED_GROUPS=
# 不想搭理哪些 QQ 号（比如别的机器人、小号），英文逗号分隔
IGNORE_QQS=

# 长期记忆：主人兼男朋友（昵称或 QQ 号，英文逗号分隔）
OWNER_NAMES=你的昵称,你的QQ号
# 长期记忆：bot 讨厌的人（私聊 ta 时语气会明显变差、多怼两句，但不会辱骂）
NEMESIS_NAMES=xxxi

# ---------- 4. 什么时候接话（行为参数） ----------
# 点名关键词，英文逗号分隔；消息里出现就会接话。
# 想只回 @、不要关键词触发，就把它留空：TRIGGER_KEYWORDS=
TRIGGER_KEYWORDS=大肥鱼,肥鱼
# 没被 @、也没命中关键词时，随机插话的概率：0.06 = 6%
REPLY_RATE=0.06
# 同一个群两次主动接话的最小间隔（秒），防止刷屏
COOLDOWN_SECONDS=20
# 同一个群每小时最多回多少条（含被 @ 的）
MAX_REPLIES_PER_HOUR=300
# 群聊每分钟最多回多少条（含 @、自动回复、token 梗）
MAX_REPLIES_PER_MINUTE=10
# 私聊每分钟最多回多少条
MAX_PRIVATE_REPLIES_PER_MINUTE=5
# 每个群给大模型看多少条历史消息（越多越聪明，也越费 token）
CONTEXT_TURNS=16
# 单条消息最多读取多少字（超出截断，防止长文烧 token）
MAX_INPUT_CHARS=200
# 每次请求最多带多少字聊天历史（超出从最旧的开始丢）
MAX_CONTEXT_CHARS=2000
# 单条回复最多多少字，超出会被截断
MAX_REPLY_CHARS=160
# 是否把回复拆成 2~3 条气泡发出（更像真人打字）
MULTI_BUBBLE=true
# 安静时段，例如 1-7 表示 01:00~07:00 不说话；留空 = 全天在线。
# 支持跨零点：23-7
QUIET_HOURS=
# 是否把最近的群消息存在本地 data/memory.json（重启后还记得）
PERSIST_MEMORY=true

# 运行日志：同时写控制台和这个文件，方便后台排查（可删）
LOG_FILE=data/bot.log
